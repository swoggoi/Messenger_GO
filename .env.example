# Локальный запуск на Windows: Go работает на хосте, PostgreSQL/Redis — в Docker Compose.
PORT=8080
DB_SOURCE=postgres://messenger:messenger_pass@localhost:5432/messenger_db?sslmode=disable
# start.bat подставляет случайное значение вместо REPLACE_WITH...
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Kafka не обязательна для локальной переписки: приложение запускается без неё.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=messenger-messages
# Пустой список = только same-origin. Для кросс-домена перечислите точные адреса через запятую.
CORS_ALLOWED_ORIGINS=
