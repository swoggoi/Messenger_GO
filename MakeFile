include .env
export


service-run:
	go run main.go
service-deploy:
	docker compose up -d application
service-undeploy:
	docker compose down application
migrate-up:
	@migrate -path migrations -database ${CONN_STRING} up 
migrate-down:
	@migrate -path migrations -database ${CONN_STRING} down
migrate-up-1:
	@migrate -path migrations -database ${CONN_STRING} up 1
migrate-down-1:
	@migrate -path migrations -database ${CONN_STRING} down 1

